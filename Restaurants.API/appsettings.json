{
  "ConnectionStrings": {
    "default": "Server=.\\SQLEXPRESS;Database=RestaurantsApi;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }

    },
    "WriteTo": [
      {
        "Name": "Console"
      },
           {
        "Name": "File",
            "Args": {
              "path": "Logs/Restaurant-API-.log",
              "rollingInterval": "Day",
              "rollOnFileSizeLimit": true
            }
      }
    
    ]

    
  },
  "AllowedHosts": "*"
}
